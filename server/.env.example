NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kaifs_gym
# Replace with a private random value of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# Positive integer duration using s, m, h, or d (for example 1d).
JWT_EXPIRES_IN=1d
COOKIE_NAME=kaifs_gym_token
# Must be true in production; SameSite=None also requires true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
